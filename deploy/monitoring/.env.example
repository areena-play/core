# ==============================================================================
# AREENA CENTRAL MONITORING & LOGGING STACK CONFIGURATION (.env)
# ==============================================================================

# 1. DOMAINS & SSL
LOGS_DOMAIN=logs.areena.ch
STATUS_DOMAIN=status.areena.ch
LETSENCRYPT_EMAIL=admin@areena.ch

# 2. GRAFANA ADMIN CREDENTIALS
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=SetAStrongPasswordHere2026!

# 3. SHIPPER BASIC AUTH HASH
# Generate using: docker run --rm caddy:2-alpine caddy hash-password --plaintext "YourShipperPasswordHere"
SHIPPER_PASSWORD_HASH=$2a$14$exampleHashedPasswordHere...

      },
      "targets": [
        {
          "expr": "{host=~\"$host\", service=~\"$service\"} |=~ \"(?i)(error|exception|failed|fatal|5\\\\d\\\\d)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "prettifyLogMessage": true
      }
    },
    {

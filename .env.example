# ==============================================================================
# AREENA LOCAL DEVELOPMENT ENVIRONMENT (.env)
# ==============================================================================
# For local development:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Run local infrastructure: docker compose up -d
#   3. Run apps locally:        npm run dev
#
# NOTE FOR PRODUCTION & DEPLOY DEV:
#   Do NOT commit .env or supply a full .env file to GitHub.
#   All values are supplied via individual GitHub Actions Variables & Secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION PORTS AND DEFINITIONS
# ------------------------------------------------------------------------------
# In production this is always set to production
NODE_ENV=development
# Port definitions for local development only (frontend, backend, websocket)
FRONTEND_PORT=3000
BACKEND_PORT=4000
WS_PORT=5000
# Ignored in production, but required for local development to properly set the websocket URL in the frontend
NEXT_PUBLIC_WS_PORT=5000
DOMAIN_NAME=localhost
AREENA_SUPPORT_EMAIL=support@areena.ch
# In production, this defaults to https://<DOMAIN_NAME> or is overridden via GitHub Variables
# Override this, if the installation is served under a subpath (e.g. https://example.com/areena). This is used for generating absolute URLs in emails, web push notifications, and other places.
# In local dev, this is required to be set to http://localhost:<FRONTEND_PORT> for proper functioning, otherwise it will default to https
APP_BASE_URL=http://localhost:3000
# default: false (set to true for demo site features, accounts panel, and 2am reset scheduler)
IS_DEMO=false
# Override this, if the backend is served under a different URL than the frontend (e.g. https://api.example.com)
BACKEND_INTERNAL_URL=http://localhost:4000
SERVER_NAME=areena-local
LETSENCRYPT_EMAIL=admin@areena.ch

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# In GitHub Secrets: Set JWT_SECRET (or PROD_JWT_SECRET / DEV_JWT_SECRET)
JWT_SECRET=dev-secret-key-super-secure-change-in-prod-123456789

# ------------------------------------------------------------------------------
# 3. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Local Docker PostgreSQL defaults (only used in local development)
DB_USER=areena_admin
DB_PASS=supersecretpassword
DB_NAME=areena_db
DB_HOST=db
DB_PORT=5432

# In GitHub Secrets: Set DATABASE_URL (or PROD_DATABASE_URL / DEV_DATABASE_URL)
DATABASE_URL=postgresql://areena_admin:supersecretpassword@localhost:5432/areena_db?schema=public

# ------------------------------------------------------------------------------
# 4. CACHE & PUB/SUB (Redis)
# ------------------------------------------------------------------------------
# In GitHub Variables / Secrets: Set REDIS_URL (or PROD_REDIS_URL / DEV_REDIS_URL)
# Set this only in production, to something like redis://redis.url.com:6379
REDIS_URL=

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (MinIO / S3)
# ------------------------------------------------------------------------------
# Local MinIO emulator defaults (these are ignored in production)
MINIO_USER=minioadmin
MINIO_PASS=minioadmin
MINIO_BUCKET_NAME=areena-local-storage
MINIO_REGION=eu-central-2

# S3 credentials for backend
# These are ignored in local development
# In GitHub Secrets: Set AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY
# In GitHub Variables: Set AWS_BUCKET_NAME, AWS_REGION, AWS_ENDPOINT
# leave empty, if you want to use the default AWS S3 endpoint (https://s3.amazonaws.com), set by the s3 library automatically
AWS_ENDPOINT=
AWS_REGION=eu-central-2
AWS_ACCESS_KEY_ID=secret-id
AWS_SECRET_ACCESS_KEY=secret-key
AWS_BUCKET_NAME=areena-storage

# ------------------------------------------------------------------------------
# 6. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# In GitHub Variables / Secrets: Set VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@areena.ch

# ------------------------------------------------------------------------------
# 7. PRODUCTION / DEPLOYMENT ONLY (Caddy SSL & Monitoring)
# ------------------------------------------------------------------------------
# In GitHub Variables: LOGGING_URL, LOGGING_USER
# In GitHub Secrets: LOGGING_PASSWORD
LOGGING_URL=
LOGGING_USER=shipper
LOGGING_PASSWORD=
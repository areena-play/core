# ==============================================================================
# AREENA ENVIRONMENT CONFIGURATION REFERENCE (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MANDATORY PRODUCTION VARIABLES (Required for Live / Demo / Dev)
# ------------------------------------------------------------------------------

# PostgreSQL Database Connection String
# Example: postgresql://username:password@your-db-host.com:5432/database_name?schema=public
DATABASE_URL=postgresql://areena_admin:supersecretpassword@localhost:5432/areena_db?schema=public

# S3 Storage Credentials (AWS S3, Cloudflare R2, MinIO, Wasabi, etc.)
AWS_ACCESS_KEY_ID=your_s3_access_key_here
AWS_SECRET_ACCESS_KEY=your_s3_secret_key_here
AWS_BUCKET_NAME=areena-storage

# Security Keys (Generate random 32+ character strings for production)
JWT_SECRET=areena_jwt_secret_change_me_in_production_2026
INTERNAL_API_SECRET=areena_internal_server_secret_change_me_2026


# ------------------------------------------------------------------------------
# 2. SSL & DOMAIN CONFIGURATION (Let's Encrypt automated SSL)
# ------------------------------------------------------------------------------

# Your public domain name (e.g. demo.areena.ch or dev.areena.ch)
DOMAIN_NAME=demo.areena.ch

# Email address for Let's Encrypt expiration notifications
LETSENCRYPT_EMAIL=admin@areena.ch


# ------------------------------------------------------------------------------
# 3. OPTIONAL CONFIGURATIONS (With default fallbacks)
# ------------------------------------------------------------------------------

# S3 Endpoint URL (Required for Cloudflare R2, MinIO, or custom S3 providers)
# - For Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# - For Local MinIO:   http://localhost:9000
# - For Standard AWS:  Leave empty or omit
S3_ENDPOINT=

# AWS / S3 Region (Default: eu-central-2 or 'auto' for Cloudflare R2)
AWS_REGION=eu-central-2

# WebSocket URL override (Optional - auto-detected as wss://<domain>/ws in production)
# NEXT_PUBLIC_WS_URL=wss://demo.areena.ch/ws

# Redis Connection URL (Default in Docker Compose: redis://redis:6379)
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 4. DEMO SITE CONFIGURATION
# ------------------------------------------------------------------------------

# Set to 'true' to enable demo mode:
# - Displays the pre-configured role-based demo accounts quick-login panel on /auth/login
# - Automatically activates the daily 2:00 AM CET database reset scheduler to restore seed data
# - Exposes demo status in the public system configuration
# Defaults to 'false' if omitted.
IS_DEMO=false

# ------------------------------------------------------------------------------
# 5. EMAIL SETTINGS
# ------------------------------------------------------------------------------

# GENERAL EMAIL CONFIGURATION (Required for sending emails from the platform)
# Sender From Header override
EMAIL_FROM_DEFAULT="AREENA Platform <no-reply@areena.ch>"

# MAILGUN HTTP REST API CONFIGURATION (Recommended for Bulk & Transactional)
# Mailgun API Private Key (from Mailgun Dashboard > API Security)
MAILGUN_API_KEY=
# Mailgun Sending Domain (e.g. mg.areena.ch or areena.ch)
MAILGUN_DOMAIN=
# Mailgun Region Host: Default 'https://api.mailgun.net' or set MAILGUN_EU=true for EU 'https://api.eu.mailgun.net'
MAILGUN_EU=false

# SMTP EMAIL CONFIGURATION (Fallback if Mailgun API is not used)
# SMTP Server Host (e.g. smtp.mailgun.org, smtp.resend.com, smtp.sendgrid.net, mail.yourdomain.ch)
SMTP_HOST=
# SMTP Port (Default: 587 for STARTTLS, 465 for SSL/TLS, 25 for local relay)
SMTP_PORT=587
# SMTP Username / API Key
SMTP_USER=
# SMTP Password / Secret Key
SMTP_PASS=
# Force TLS/SSL on connection (true for port 465, false for 587)
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 6. OTHER CONFIGURATIONS
# ------------------------------------------------------------------------------

# Platform-wide support fallback email address
AREENA_SUPPORT_EMAIL=support@areena.ch
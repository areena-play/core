{
    "name": "areena-monorepo",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "build": "npm run build --workspace=@areena/shared && npm run build --workspaces --if-present",
        "predev": "docker compose up -d db redis s3 vector",
        "dev": "concurrently -n \"BACKEND,FRONTEND,WS\" -c \"blue,green,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:ws\"",
        "dev:services": "docker compose up -d db redis s3 vector",
        "dev:stop": "docker compose down",
        "dev:backend": "npm run dev --workspace=@areena/backend",
        "dev:frontend": "npm run dev --workspace=@areena/frontend",
        "dev:ws": "npm run dev --workspace=@areena/websocket-server",
        "prisma:generate": "npm run prisma:generate --workspace=@areena/backend",
        "prisma:migrate": "npm run prisma:migrate --workspace=@areena/backend",
        "prisma:seed": "npm run prisma:seed --workspace=@areena/backend",
        "demo:seed": "npm run prisma:seed --workspace=@areena/backend",
        "demo:reset": "npm run prisma:seed --workspace=@areena/backend",
        "version:sync": "node scripts/sync-versions.js",
        "version:patch": "node scripts/bump-version.js patch",
        "version:minor": "node scripts/bump-version.js minor",
        "version:major": "node scripts/bump-version.js major"
    },
    "devDependencies": {
        "@types/pngjs": "^6.0.5",
        "concurrently": "^9.1.2",
        "pngjs": "^7.0.0",
        "typescript": "^5.8.2"
    }
}

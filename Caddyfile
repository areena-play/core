{
    # Global options - Let's Encrypt / ZeroSSL contact email
    email {$LETSENCRYPT_EMAIL}
}

{$DOMAIN_NAME} {
    # Enable structured HTTP access logging with client IP addresses
    log {
        output stdout
        format json
    }

    # 1. WebSocket endpoint (/ws and /ws/*)
    handle /ws* {
        reverse_proxy websocket:{$WS_PORT:5000}
    }

    # 2. Direct to Express API Backend (stripping /api prefix)
    handle /api* {
        uri strip_prefix /api
        reverse_proxy backend:{$BACKEND_PORT:4000}
    }

    # 3. Next.js Frontend
    handle {
        reverse_proxy frontend:{$FRONTEND_PORT:3000}
    }
}

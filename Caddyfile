{
    # Global options - Let's Encrypt / ZeroSSL contact email
    email {$LETSENCRYPT_EMAIL}
}

{$DOMAIN_NAME:localhost} {
    # 1. WebSocket endpoint (/ws and /ws/*)
    handle /ws* {
        reverse_proxy websocket:5000
    }

    # 2. Direct to Express API Backend (stripping /api prefix)
    handle /api* {
        uri strip_prefix /api
        reverse_proxy backend:4000
    }

    # 3. Next.js Frontend
    handle {
        reverse_proxy frontend:3000
    }
}

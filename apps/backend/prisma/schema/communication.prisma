enum EventType {
  TOURNAMENT
  LEAGUE_MATCH
  REFRESHER_COURSE
  ASSOCIATION_MEETING
  CLUB_EVENT
  TRAINING
}

enum MessageChannel {
  EMAIL
  SMS
}

enum AuditCategory {
  AUTH
  GOVERNANCE
  FINANCE
  COMMUNICATION
  LICENSING
  TOURNAMENT
  CLUB
  DEVELOPER
  SECURITY
}

model CalendarEvent {
  id            String    @id @default(uuid())
  title         String
  description   String?
  eventType     EventType
  associationId String?
  clubId        String?
  competitionId String?
  encounterId   String?
  startDate     DateTime
  endDate       DateTime
  location      String?
  isPublic      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  association Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)
  club        Club?        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  competition Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  encounter   Encounter?   @relation(fields: [encounterId], references: [id], onDelete: Cascade)
}

model BroadcastMessage {
  id            String         @id @default(uuid())
  senderUserId  String
  associationId String?
  clubId        String?
  subject       String
  body          String
  channel       MessageChannel @default(EMAIL)
  targetFilter  Json           @default("{}")
  sentAt        DateTime       @default(now())

  sender      User               @relation("SenderUser", fields: [senderUserId], references: [id], onDelete: Cascade)
  association Association?       @relation(fields: [associationId], references: [id], onDelete: SetNull)
  club        Club?              @relation(fields: [clubId], references: [id], onDelete: SetNull)
  recipients  MessageRecipient[]
}

model MessageRecipient {
  id              String   @id @default(uuid())
  messageId       String
  recipientUserId String
  status          String   @default("SENT") // QUEUED, SENT, DELIVERED, FAILED
  deliveredAt     DateTime @default(now())

  message   BroadcastMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient User             @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientUserId])
}

model AuditLog {
  id            String        @id @default(uuid())
  userId        String?
  userEmail     String
  userName      String?
  action        String
  category      AuditCategory @default(GOVERNANCE)
  entityType    String?
  entityId      String?
  associationId String?
  clubId        String?
  tournamentId  String?
  description   String
  status        String        @default("SUCCESS") // SUCCESS, FAILURE, WARNING
  ipAddress     String        @default("127.0.0.1")
  userAgent     String        @default("Unknown")
  metadata      Json          @default("{}")
  createdAt     DateTime      @default(now())

  user        User?        @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  association Association? @relation("AssociationAuditLogs", fields: [associationId], references: [id], onDelete: SetNull)
  club        Club?        @relation("ClubAuditLogs", fields: [clubId], references: [id], onDelete: SetNull)

  @@index([associationId])
  @@index([clubId])
  @@index([userId])
  @@index([category])
  @@index([action])
  @@index([createdAt])
}

enum NoticeType {
  INFO
  WARNING
  CRITICAL
  SUCCESS
}

enum NoticeDisplayMode {
  BANNER
  MODAL
}

enum NoticeTargetGroup {
  ALL
  SUPER_ADMINS
  ASSOCIATION_ADMINS
  CLUB_ADMINS
  PLAYERS
  COACHES
  REFEREES
}

model AdminNotice {
  id            String            @id @default(uuid())
  title         String
  content       String
  titleI18n     Json?
  contentI18n   Json?
  type          NoticeType        @default(INFO)
  displayMode   NoticeDisplayMode @default(BANNER)
  targetGroup   NoticeTargetGroup @default(ALL)
  associationId String?
  clubId        String?
  isDismissible Boolean           @default(true)
  isActive      Boolean           @default(true)
  priority      Int               @default(0)
  startsAt      DateTime          @default(now())
  expiresAt     DateTime?
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  createdBy   User              @relation("CreatedAdminNotices", fields: [createdById], references: [id], onDelete: Cascade)
  association Association?      @relation(fields: [associationId], references: [id], onDelete: SetNull)
  club        Club?             @relation(fields: [clubId], references: [id], onDelete: SetNull)
  dismissals  NoticeDismissal[]

  @@index([targetGroup])
  @@index([isActive])
  @@index([createdAt])
}

model NoticeDismissal {
  id          String   @id @default(uuid())
  noticeId    String
  userId      String
  dismissedAt DateTime @default(now())

  notice AdminNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User        @relation("UserNoticeDismissals", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum RelationshipType {
  PARENT_GUARDIAN
  CLUB_COACH
  TEAM_CAPTAIN
  DELEGATED_COMPANION
}

enum RelationshipPermission {
  FULL_MANAGEMENT
  TOURNAMENT_ONLY
  VIEW_AND_ALERTS_ONLY
}

model UserRelationship {
  id                 String                 @id @default(uuid())
  managerUserId      String
  managedUserId      String
  type               RelationshipType       @default(PARENT_GUARDIAN)
  permission         RelationshipPermission @default(FULL_MANAGEMENT)
  isEmergencyContact Boolean                @default(false)
  emergencyPhone     String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  manager            User                   @relation("ManagerUser", fields: [managerUserId], references: [id], onDelete: Cascade)
  managed            User                   @relation("ManagedUser", fields: [managedUserId], references: [id], onDelete: Cascade)

  @@unique([managerUserId, managedUserId])
  @@index([managerUserId])
  @@index([managedUserId])
}



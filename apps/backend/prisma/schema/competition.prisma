enum CompetitionRole {
  ADMIN
  ENTER_RESULTS
  ASSIGN_COURTS
  SPEAKER
  HEAD_REFEREE
  REFEREE
  CASHIER
  CREATE_BACKUPS
  EDIT_REGISTRATIONS
}

enum CompetitionType {
  LEAGUE
  TOURNAMENT
  SEASON_TOURNAMENT
  CUP
  INOFFICIAL
  FRIENDLY
  RANKING_TOURNAMENT
}

enum CompetitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum GenderRestriction {
  ANY
  MALE_ONLY
  FEMALE_ONLY
  MIXED
}

enum EncounterStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum MatchType {
  SINGLE
  DOUBLE
}

enum MatchWinner {
  HOME
  AWAY
  DRAW
  PENDING
}

enum ParticipantSide {
  HOME
  AWAY
  NEUTRAL
}

model Competition {
  id               String            @id @default(uuid())
  type             CompetitionType
  name             String
  slug             String            @unique
  seriesSlug       String?
  description      String?
  associationId    String
  seasonId         String?
  startDate        DateTime
  endDate          DateTime
  location         String?
  status           CompetitionStatus @default(DRAFT)
  isOfficial       Boolean           @default(true)
  countsForElo     Boolean           @default(true)
  requiresApproval Boolean           @default(false)
  approvalStatus   String            @default("APPROVED")
  createdById      String?
  entryFee         Float?            @default(0)

  // 1. General & Multilingual Branding
  nameShort        String?
  nameDiploma      String?
  nameI18n         Json?             @default("{}")
  tournamentHomeText String?
  sportId          String?
  isSimpleMode     Boolean           @default(false)

  // 2. Schedule, Timings & Deadlines
  plannedStartTime String?
  plannedEndTime   String?
  regStartTime     DateTime?
  regEndTime       DateTime?
  deregEndTime     DateTime?
  deregInfo        String?
  blockEnrollment  Boolean           @default(false)
  regPassword      String?
  noRegPasswordForConfirmation Boolean @default(false)

  // 3. Financials, Fees & Discounts
  currency                        String   @default("CHF")
  associationCostSingle           Float?   @default(0)
  associationCostEachDay          Boolean  @default(false)
  noAssociationCostForUnlicensed  Boolean  @default(false)
  fineCost                        Float?   @default(0)
  manyEnrollmentsDiscount         Float?   @default(0)
  manyEnrollmentsNrCategories     Int?     @default(2)
  manyEnrollmentsDiscountOnlyTotal Boolean @default(false)
  manyEnrollmentsAlsoJuniorCost   Boolean  @default(false)
  manyEnrollmentsAlsoTeamCost     Boolean  @default(false)
  moreDiscounts                   Json?    @default("[]")
  allowOnlinePayment              Boolean  @default(false)
  forcePaymentDelay               Int?     @default(0)
  enrollmentConfirmationDelay     Int?     @default(0)

  // 4. Eligibility, Restrictions & Limits
  maxNrRegistrationsPerPlayer Int?     @default(0)
  maxNrRegistrations          Int?     @default(0)
  maxNrPlayers                Int?     @default(0)
  allowOnlyRegions            Json?    @default("[]")
  allowOnlyClubs              Json?    @default("[]")
  playerBlacklist             String?
  ageCutMonth                 Int?     @default(0)
  juniorAge                   Int?     @default(18)
  categoryConflicts           Json?    @default("[]")
  forceTelNr                  Boolean  @default(false)
  additionalDataClub          Boolean  @default(false)
  additionalDataLevel         Boolean  @default(false)
  additionalDataEmail         Boolean  @default(false)
  autoEnrollIfOnlyOneCategory Boolean  @default(false)

  // 5. Match Logistics, Courts & Match Forms
  chiefReferee               String?
  allPlayersCanBeReferees    Boolean  @default(false)
  allowRefOnlyOnCorrectTable Boolean  @default(false)
  allowDoubleCourtUsage      Boolean  @default(false)
  noWhenCourtFreeMessage     Boolean  @default(false)
  allowMatchesWithoutCourt   Boolean  @default(false)
  usersCanAddAvailableCourts Boolean  @default(false)
  defaultCourtOrder          String?
  autoSetGamesToCalledOut    Boolean  @default(false)
  maxNrCallouts              Int      @default(3)
  automatedCallouts          Boolean  @default(false)
  usePushNotifications       Boolean  @default(false)
  skipAwardCeremonies        Boolean  @default(false)
  useShirtNumbers            Boolean  @default(false)
  printClubOnMatchform       Boolean  @default(true)
  printLevelOnMatchform      Boolean  @default(true)
  printShortTournamentName   Boolean  @default(false)
  printPlannedStartTime      Boolean  @default(true)
  printCourtPlaceDetails     Boolean  @default(true)
  showOnlyPlaceNotCourt      Boolean  @default(false)
  playersCanPrintMatchForm   Boolean  @default(false)
  advancedMatchFormTwoRows   Boolean  @default(false)

  // 6. Draw, Waitlists & Visibility
  allowWaitlist                Boolean  @default(true)
  hideWaitlistForNonadmins     Boolean  @default(false)
  autoConfirmTeams             Boolean  @default(false)
  autoConfirmDoubles           Boolean  @default(false)
  teamChangeKeepWaitlist       Boolean  @default(false)
  drawOnlyDisplayPresentTeams  Boolean  @default(false)
  drawOnlyDisplayPaidTeams     Boolean  @default(false)
  categoryRankingsShowAllTeams Boolean  @default(false)
  categorySortMode             String   @default("restrictions")
  categorySortModeRestrictions String   @default("teamsize")

  // 7. Sub-Tournaments
  hasSubTournaments                      Boolean  @default(false)
  subTournamentsName                     Json?
  subTournamentsNamePlural               Json?
  subTournamentPassword                  String?
  allowSamePlayerInMultipleSubTournaments Boolean @default(false)
  newSubTournamentInfotext               String?

  // 8. Communications & Emails
  registrationMailText     String?
  registrationMailHideCost Boolean  @default(false)

  // 9. Organizer Invoicing & Banking Details
  organizerName         String?
  organizerIban         String?
  organizerCountry      String?  @default("CH")
  organizerZip          String?
  organizerCity         String?
  organizerStreet       String?
  organizerStreetNumber String?

  // 10. Operations & Backups
  autoBackup           Int?     @default(20)
  keepNrBackups        Int?     @default(10)
  backupWithChangeData Boolean  @default(true)
  showInArchive        Boolean  @default(true)
  hideInGlobalArchive  Boolean  @default(false)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  association        Association                 @relation(fields: [associationId], references: [id], onDelete: Cascade)
  season             Season?                     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  sport              Sport?                      @relation(fields: [sportId], references: [id], onDelete: SetNull)
  categories         Category[]
  calendarEvents     CalendarEvent[]
  faqItems           FaqItem[]
  supportSubjects    SupportSubject[]
  locations          CompetitionLocation[]
  unitReservations   LocationUnitReservation[]
  roles              CompetitionUserRole[]
  speakerCallouts    CompetitionSpeakerCallout[]
  tournamentLicenses License[]                   @relation("TournamentLicenses")

  @@index([seriesSlug])
  @@index([sportId])
}

model Category {
  id                  String            @id @default(uuid())
  competitionId       String
  name                String
  nameI18n            Json?
  teamSize            Int               @default(1)
  minElo              Int?
  maxElo              Int?
  minAge              Int?
  maxAge              Int?
  genderRestriction   GenderRestriction @default(ANY)
  requiredLicenseType LicenseType?
  encounterFormat     Json              @default("[]")
  roundsPerGroup      Int               @default(1)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  competition Competition   @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  groups      CategoryGroup[]
  encounters  Encounter[]
  matches     Match[]
  teams       Team[]
}

model Team {
  id                      String   @id @default(uuid())
  categoryId              String
  name                    String
  clubId                  String?
  onSiteResponsibleUserId String?
  emergencyPhone          String?
  paymentStatus           String   @default("UNPAID")
  paidAmount              Float?   @default(0)
  paymentMethod           String?
  isCheckedIn             Boolean  @default(false)
  registeredAt            DateTime @default(now())
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  club              Club?              @relation(fields: [clubId], references: [id], onDelete: SetNull)
  members           TeamMember[]
  onSiteResponsible User?              @relation("SupervisedRegistrations", fields: [onSiteResponsibleUserId], references: [id], onDelete: SetNull)
  homeEncounters    Encounter[]        @relation("HomeTeamEncounters")
  awayEncounters    Encounter[]        @relation("AwayTeamEncounters")
  standings         GroupStanding[]
  matchParticipants MatchParticipant[]

  @@index([categoryId])
  @@index([onSiteResponsibleUserId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      String   @default("PLAYER") // CAPTAIN, PLAYER, RESERVE
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model CategoryGroup {
  id         String   @id @default(uuid())
  categoryId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  encounters Encounter[]
  matches    Match[]
  standings  GroupStanding[]

  @@index([categoryId])
}

model GroupStanding {
  id          String   @id @default(uuid())
  groupId     String
  teamId      String
  played      Int      @default(0)
  won         Int      @default(0)
  drawn       Int      @default(0)
  lost        Int      @default(0)
  matchesWon  Int      @default(0)
  matchesLost Int      @default(0)
  setsWon     Int      @default(0)
  setsLost    Int      @default(0)
  pointsWon   Int      @default(0)
  pointsLost  Int      @default(0)
  tablePoints Int      @default(0)
  updatedAt   DateTime @updatedAt

  group CategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  team  Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([groupId, teamId])
  @@index([groupId])
  @@index([teamId])
}

model Encounter {
  id          String          @id @default(uuid())
  categoryId  String
  groupId     String?
  round       Int             @default(1)
  scheduledAt DateTime
  location    String?
  homeTeamId  String
  awayTeamId  String
  homeScore   Int             @default(0)
  awayScore   Int             @default(0)
  status      EncounterStatus @default(SCHEDULED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group          CategoryGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  homeTeam       Team            @relation("HomeTeamEncounters", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam       Team            @relation("AwayTeamEncounters", fields: [awayTeamId], references: [id], onDelete: Cascade)
  matches        Match[]
  calendarEvents CalendarEvent[]

  @@index([categoryId])
  @@index([groupId])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model Match {
  id          String          @id @default(uuid())
  categoryId  String
  groupId     String?
  encounterId String?
  round       Int?            @default(1)
  orderIndex  Int             @default(1)
  matchType   MatchType       @default(SINGLE)
  label       String?
  scheduledAt DateTime?
  location    String?
  result      String?
  homeScore   Int             @default(0)
  awayScore   Int             @default(0)
  resultType  ResultType?
  rulesConfig Json?
  winner      MatchWinner     @default(PENDING)
  status      EncounterStatus @default(SCHEDULED)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  group        CategoryGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  encounter    Encounter?         @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  participants MatchParticipant[]

  @@index([categoryId])
  @@index([groupId])
  @@index([encounterId])
}

model MatchParticipant {
  id                String                 @id @default(uuid())
  matchId           String
  userId            String
  side              ParticipantSide        @default(HOME)
  position          Int                    @default(1)
  bibNumber         String?
  rank              Int?
  timeMs            Int?
  result            String?
  splitTimes        Json?                  @default("[]")
  participantStatus String?                @default("REGISTERED")
  points            Float?
  teamId            String?
  clubIdAtTime      String?
  licenseIdUsed     String?
  ratingSnapshotId  String?
  createdAt         DateTime               @default(now())

  match          Match                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team           Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  club           Club?                  @relation(fields: [clubIdAtTime], references: [id], onDelete: SetNull)
  license        License?               @relation(fields: [licenseIdUsed], references: [id], onDelete: SetNull)
  ratingSnapshot RatingSnapshotHistory? @relation(fields: [ratingSnapshotId], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([userId])
  @@index([ratingSnapshotId])
}

model CompetitionUserRole {
  id            String          @id @default(uuid())
  competitionId String
  userId        String
  role          CompetitionRole
  createdAt     DateTime        @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId, role])
}

model CompetitionSpeakerCallout {
  id            String   @id @default(uuid())
  competitionId String
  title         String
  message       String
  type          String   @default("MATCH_CALL")
  unitName      String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
}

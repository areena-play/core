enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceCategory {
  MEMBERSHIP_FEE
  LICENSE_FEE
  COMPETITION_ENTRY
  COURSE_FEE
  EQUIPMENT
  PENALTY
  OTHER
}

enum InvoiceTargetType {
  MEMBER_CLUB
  CLUB_MEMBER
  INDIVIDUAL_PLAYER
  SUB_ASSOCIATION
  OTHER
}

model Invoice {
  id               String            @id @default(uuid())
  invoiceNumber    String            @unique
  associationId    String?
  clubId           String?
  targetType       InvoiceTargetType @default(MEMBER_CLUB)
  recipientClubId  String?
  recipientUserId  String?
  recipientName    String
  recipientEmail   String?
  recipientAddress String?
  status           InvoiceStatus     @default(DRAFT)
  category         InvoiceCategory   @default(MEMBERSHIP_FEE)
  currency         String            @default("CHF")
  subtotal         Float
  taxRate          Float             @default(0.0)
  taxAmount        Float             @default(0.0)
  totalAmount      Float
  issueDate        DateTime          @default(now())
  dueDate          DateTime
  paidAt           DateTime?
  notes            String?
  terms            String?
  bexioId          Int?
  bexioSyncedAt    DateTime?
  bexioSyncStatus  String?           @default("NOT_CONFIGURED") // NOT_CONFIGURED, PENDING, SYNCED, FAILED
  bexioQrPdfUrl    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  association   Association?      @relation("AssociationInvoices", fields: [associationId], references: [id], onDelete: SetNull)
  club          Club?             @relation("ClubInvoices", fields: [clubId], references: [id], onDelete: SetNull)
  recipientClub Club?             @relation("ClubInvoicesReceived", fields: [recipientClubId], references: [id], onDelete: SetNull)
  recipientUser User?             @relation("InvoiceRecipientUser", fields: [recipientUserId], references: [id], onDelete: SetNull)
  lineItems     InvoiceLineItem[]
}

model InvoiceLineItem {
  id             String   @id @default(uuid())
  invoiceId      String
  position       Int      @default(1)
  description    String
  quantity       Float    @default(1.0)
  unit           String   @default("pc")
  unitPrice      Float
  totalPrice     Float
  taxRate        Float    @default(0.0)
  bexioArticleId Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model BexioConfig {
  id             String    @id @default(uuid())
  associationId  String?   @unique
  clubId         String?   @unique
  apiToken       String?
  userId         Int?
  bankAccountId  Int?
  taxId          Int?
  paymentTypeId  Int?
  iban           String?
  qrIban         String?
  companyName    String?
  companyAddress String?
  autoSync       Boolean   @default(true)
  isConnected    Boolean   @default(false)
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  association Association? @relation(fields: [associationId], references: [id], onDelete: Cascade)
  club        Club?        @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

